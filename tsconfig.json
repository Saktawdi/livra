{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node", "vite/client"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts"]
}
