HOST=127.0.0.1
PORT=3400
DATA_DIR=../../.data
# Public reverse proxy origin; required when web and API use different origins.
# PUBLIC_ORIGIN=https://livra.example.com
# Optional access password for a private deployment.
# ACCESS_PASSWORD=replace-with-a-long-random-password
# Empty disables the optional Sakta integration.
# A service root or a URL ending in /v1 is accepted; deployment prefixes are preserved.
SAKTA_BASE_URL=https://api.sakta.top
# Optional self-hosted search endpoint.
# SEARXNG_URL=http://searxng:8080
# Allow private model/search/tool services such as Ollama. Administrator choice.
# ALLOW_PRIVATE_ENDPOINTS=true
# Trust only your reverse proxy addresses, comma separated; never enable for untrusted peers.
# TRUST_PROXY=loopback
# Build-time frontend API origin; prefer a same-origin /api reverse proxy.
# VITE_API_URL=https://livra.example.com
